---
import WorkshopLayout from '../../../../components/workshop/WorkshopLayout.astro';
const title = 'Vehicle Intake | WorkshopGirl Workshop Operations';
const description = 'Record customer and vehicle details in a private local workshop intake, then continue into inspection and repair.';
const canonical = 'https://workshopgirl.com/tools/workshop/vehicle-intake/';
---
<WorkshopLayout title={title} description={description} canonical={canonical} step="intake" heading="Vehicle intake." intro="Start a local workshop job. Customer and vehicle details stay in this browser and carry forward through the job.">
  <section class="workshop-card"><h2>Start or resume a job</h2><p>Create a new intake or open an existing local job.</p><form id="intake-form" class="workshop-form" novalidate>
    <section class="form-section"><h2>Customer</h2><div class="form-grid"><label><span>Name *</span><input name="customerName" autocomplete="name" required /></label><label><span>Phone</span><input name="phone" autocomplete="tel" type="tel" /></label><label class="form-span-all"><span>Address</span><textarea name="address" autocomplete="street-address"></textarea></label></div></section>
    <section class="form-section"><h2>Vehicle</h2><div class="form-grid three-col"><label><span>Type *</span><select name="vehicleType"><option>Motorcycle</option><option>Car</option></select></label><label><span>License plate *</span><input name="plate" autocomplete="off" required /></label><label><span>Make</span><input name="make" /></label><label><span>Model</span><input name="model" /></label><label><span>Year</span><input name="year" type="number" min="1886" /></label><label><span>Color</span><input name="color" /></label><label><span>Odometer</span><input name="odometer" type="number" min="0" /></label></div></section>
    <section class="form-section"><h2>Visit</h2><div class="form-grid"><label class="form-span-all"><span>Complaint / reason for visit</span><textarea name="complaint"></textarea></label><label><span>Accessories / items left with vehicle</span><textarea name="accessories" placeholder="One item per line"></textarea></label><label><span>Condition notes</span><textarea name="conditionNotes"></textarea></label><label><span>Intake date</span><input name="date" type="date" /></label><label><span>Arrival time</span><input name="arrivalTime" type="time" /></label></div></section>
    <p class="field-error" id="intake-error" role="alert" hidden></p><div class="button-row"><button type="submit" id="save-intake">Save intake</button></div>
  </form><div class="workflow-next" id="next-inspection" hidden><h2>Intake saved</h2><p>Customer and vehicle details are now attached to this workshop job.</p><a id="continue-inspection" href="#">Continue to Inspection &amp; Estimate →</a></div></section>
</WorkshopLayout>

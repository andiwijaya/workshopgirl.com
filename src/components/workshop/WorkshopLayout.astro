---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import ToolShare from '../ToolShare.astro';
import '../../styles/workshop-operations.css';
interface Props { title: string; description: string; canonical: string; step: string; heading: string; intro: string }
const { title, description, canonical, step, heading, intro } = Astro.props;
const steps = [
  ['intake', 'Vehicle Intake', '/tools/workshop/vehicle-intake/'],
  ['inspection', 'Inspection & Estimate', '/tools/workshop/inspection-estimate/'],
  ['work-order', 'Work Order', '/tools/workshop/work-order/'],
  ['qc', 'QC & Handover', '/tools/workshop/qc-handover/'],
  ['queue', 'Queue / Job Status', '/tools/workshop/queue/'],
  ['parts-inventory', 'Parts Inventory', '/tools/workshop/parts-inventory/'],
  ['service-history', 'Service History & Warranty', '/tools/workshop/service-history/'],
  ['billing', 'Billing', '/tools/workshop/billing/'],
  ['procurement', 'Procurement', '/tools/workshop/procurement/'],
];
---
<!doctype html><html lang="en"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head><body>
  <a class="skip-link" href="#main" tabindex="0">Skip to workshop tool</a><SiteHeader current="tools" />
  <main id="main" class="workshop-page" tabindex="-1" data-workshop-step={step}>
    <div class="workshop-hero"><a class="eyebrow" href="/tools/">WorkshopGirl / Digital workbench</a><p class="operation-label">Workshop Operations</p><h1>{heading}</h1><p>{intro}</p><ToolShare title={title} description={description} canonical={canonical} /></div>
    <nav class="workshop-steps" aria-label="Workshop job pages">
      {steps.map(([id, label, href], index) => <a href={href} data-step-link={id} aria-current={step === id ? 'step' : undefined} class:list={{ 'is-current': step === id }}><span>{id === 'queue' ? '↗' : index + 1}</span>{label}</a>)}
    </nav>
    <p class="workshop-status" id="workshop-status" role="status" aria-live="polite" hidden></p>
    <div class="workshop-job-context" id="workshop-job-context" hidden></div>
    <div class="workshop-job-picker" id="workshop-job-picker" hidden></div>
    <slot />
    <section class="print-sheet" id="print-sheet" hidden aria-label="Printable workshop document"><div class="print-brand">Workshop<span>Girl</span> · Workshop Operations</div><h2 id="print-title"></h2><div id="print-content"></div></section>
    <div class="workshop-page-actions"><a class="button-link button-secondary" href="/tools/">All tools</a><button class="button-secondary" type="button" data-print>Print / Save as PDF</button></div>
  </main>
  <SiteFooter />
  <script>import { mountWorkshopPage } from './operations.ts'; mountWorkshopPage(document.querySelector<HTMLElement>('#main')!);</script>
</body></html>

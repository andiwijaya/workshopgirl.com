---
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/sound-analyzer.css';
const title = 'Digital Workbench — Browser Tools | WorkshopGirl';
const description = 'Practical browser tools from WorkshopGirl. Start with the Sound Analyzer to measure audio, explore frequencies and compare recordings locally.';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href="https://workshopgirl.com/tools/" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content="https://workshopgirl.com/tools/" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /></head><body><SiteHeader current="tools" /><main><div class="hero"><span class="eyebrow">WorkshopGirl tools</span><h1>The digital <span>workbench.</span></h1><p>Practical tools for a closer look at the machines and sounds around you.</p></div><a class="tool-card" href="/tools/sound-analyzer/"><span class="eyebrow">Audio / locally in your browser</span><h2>Sound Analyzer</h2><p>Live microphone or audio file. Waveform, frequency spectrum, spectrogram and a useful before/after comparison.</p><strong>Open Sound Analyzer →</strong></a><a class="tool-card" href="/tools/engine-sound-analyzer/"><span class="eyebrow">Engine sound / Live measurement</span><h2>Engine Sound Analyzer</h2><p>Inspect harmonics and persistent peaks with optional RPM and firing references. Capture before/after snapshots while live, without recording.</p><strong>Open Engine Sound Analyzer →</strong></a><a class="tool-card" href="/tools/speaker-sound-analyzer/"><span class="eyebrow">Music / Captured frequency balance</span><h2>Speaker Sound Analyzer</h2><p>Play music. See its frequency balance. Explore bass, mid and treble with a simple captured sound profile.</p><strong>Open Speaker Sound Analyzer →</strong></a><p>Build your understanding with our <a href="/tutorials/">workshop tutorials</a>.</p></main><SiteFooter /></body></html>

---
interface Props {
  title: string;
  canonical: string;
  label?: string;
  idSuffix?: string;
}

const { title, canonical, label = 'Share this tutorial', idSuffix = '' } = Astro.props;
const encodedUrl = encodeURIComponent(canonical);
const encodedTitle = encodeURIComponent(title);
const shareButtonId = idSuffix ? `share-content-${idSuffix}` : 'share-content';
const copyButtonId = idSuffix ? `copy-link-${idSuffix}` : 'copy-link';
const statusId = idSuffix ? `share-status-${idSuffix}` : 'share-status';
---
<div class="share-row" data-canonical={canonical} data-title={title}>
  <div class="share-actions">
    <button class="share-button" type="button" id={shareButtonId}>{label}</button>
    <a href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">WhatsApp</a>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">Facebook</a>
    <a href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">X</a>
    <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">LinkedIn</a>
    <button class="copy-button" type="button" id={copyButtonId}>Copy Link</button>
  </div>
  <span class="share-status" id={statusId} role="status" aria-live="polite"></span>
</div>

<style>
  .share-row { margin:-28px 0 54px; }
  .share-actions { align-items:center; display:flex; flex-wrap:wrap; gap:8px; }
  .share-button,.copy-button,.share-actions a { align-items:center; border:1px solid #171717; cursor:pointer; display:inline-flex; font:600 .82rem 'DM Sans',sans-serif; justify-content:center; min-height:44px; padding:10px 12px; text-decoration:none; }
  .share-button { background:#e53b7d; border-color:#e53b7d; color:#fff; }
  .copy-button,.share-actions a { background:transparent; color:#171717; }
  .share-button:hover,.share-button:focus-visible,.copy-button:hover,.copy-button:focus-visible,.share-actions a:hover,.share-actions a:focus-visible { background:#171717; color:#fff; }
  .share-status { color:#655f59; font-size:.86rem; }
  @media (max-width:800px) { .share-actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); width:100%; } .share-actions>* { box-sizing:border-box; min-width:0; width:100%; white-space:nowrap; } }
  @media (max-width:500px) { .share-actions { grid-template-columns:repeat(2,minmax(0,1fr)); } }
</style>

<script is:inline data-share-button-id={shareButtonId} data-copy-button-id={copyButtonId} data-status-id={statusId}>
  (() => {
    const script = document.currentScript;
    const shareButtonId = script?.dataset.shareButtonId;
    const copyButtonId = script?.dataset.copyButtonId;
    const statusId = script?.dataset.statusId;
    const shareButton = shareButtonId ? document.getElementById(shareButtonId) : null;
    const copyButton = copyButtonId ? document.getElementById(copyButtonId) : null;
    const shareStatus = statusId ? document.getElementById(statusId) : null;
    const shareRow = shareButton?.closest('.share-row');
    const canonical = shareRow?.dataset.canonical ?? '';
    const title = shareRow?.dataset.title ?? '';
    let statusTimeout;
    const setStatus = (message) => {
      if (!shareStatus) return;
      window.clearTimeout(statusTimeout);
      shareStatus.textContent = message;
      statusTimeout = window.setTimeout(() => { shareStatus.textContent = ''; }, 2400);
    };
    const copyCanonical = async () => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(canonical);
        return true;
      }
      const fallback = document.createElement('textarea');
      fallback.value = canonical;
      fallback.setAttribute('readonly', '');
      fallback.style.position = 'fixed';
      fallback.style.opacity = '0';
      document.body.append(fallback);
      fallback.select();
      let copied = false;
      try { copied = document.execCommand('copy'); } finally { fallback.remove(); }
      return copied;
    };
    shareButton?.addEventListener('click', async () => {
      try {
        if (navigator.share) {
          await navigator.share({ title, text: title, url: canonical });
          setStatus('Thanks for sharing.');
        } else if (await copyCanonical()) setStatus('Copied!');
        else setStatus(canonical);
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        setStatus(canonical);
      }
    });
    copyButton?.addEventListener('click', async () => {
      try {
        if (await copyCanonical()) setStatus('Copied!');
        else setStatus(canonical);
      } catch (error) {
        setStatus(canonical);
      }
    });
  })();
</script>

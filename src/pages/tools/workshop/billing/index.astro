---
import WorkshopLayout from '../../../../components/workshop/WorkshopLayout.astro';
const title='Workshop Billing — Invoice & Payments | WorkshopGirl';
const description='Review actual workshop charges, issue local Invoice snapshots, record partial Payments, and print Receipts in this browser.';
const canonical='https://workshopgirl.com/tools/workshop/billing/';
---
<WorkshopLayout title={title} description={description} canonical={canonical} step="billing" heading="Workshop billing." intro="Review actual work and parts, confirm customer selling prices, issue an Invoice, and record Payments. Financial status stays separate from job handover.">
  <section class="billing-workbench" aria-label="Workshop Billing workbench" id="billing-root">
    <p class="queue-feedback" id="billing-message" role="status" aria-live="polite" hidden></p>
    <section class="billing-summary" id="billing-summary" aria-label="Invoice counts"></section>
    <section class="billing-jobs-panel" aria-labelledby="billing-jobs-heading"><h2 id="billing-jobs-heading">Jobs to Bill</h2><div id="billing-jobs"></div></section>
    <div class="billing-columns">
      <aside class="billing-sidebar" aria-label="Saved Invoices"><h2>Invoices</h2><div id="billing-list"></div></aside>
      <section class="billing-detail" id="billing-detail" aria-label="Selected Invoice"></section>
    </div>
  </section>
</WorkshopLayout>
<style>
  .billing-workbench{min-width:0}.billing-summary{display:grid;gap:10px;grid-template-columns:repeat(4,minmax(0,1fr));margin:18px 0}.billing-count{background:#fffaf4;border:1px solid #ded8d0;display:grid;gap:4px;min-width:0;padding:14px}.billing-count span{color:#655f59;font-size:.85rem}.billing-count strong{font-size:1.35rem}.billing-jobs-panel,.billing-sidebar,.billing-detail{background:#fffaf4;border:1px solid #ded8d0;min-width:0;padding:clamp(12px,2vw,20px)}.billing-jobs-panel>h2,.billing-sidebar>h2,.billing-detail h2{font-family:'Space Grotesk',sans-serif;font-size:1.2rem;margin:0 0 12px}.billing-columns{display:grid;gap:16px;grid-template-columns:minmax(240px,.75fr) minmax(0,2fr);margin:18px 0}.billing-sidebar{align-self:start;display:grid;gap:10px}.billing-sidebar label,.billing-detail label{display:grid;gap:6px;min-width:0}.billing-sidebar label span,.billing-detail label>span{font-size:.84rem;font-weight:700}.billing-sidebar input,.billing-sidebar select,.billing-detail input,.billing-detail select,.billing-detail textarea{background:white;border:1px solid #bdb5ac;border-radius:3px;color:#171717;font:inherit;font-size:16px;min-height:44px;min-width:0;padding:9px;width:100%}.billing-sidebar :focus-visible,.billing-detail :focus-visible{outline:3px solid #1769aa;outline-offset:2px}.billing-sidebar>div:last-child{display:grid;gap:8px}.billing-invoice-card{align-items:flex-start;background:white!important;border:1px solid #ded8d0!important;color:#171717!important;display:grid!important;gap:4px!important;justify-content:start!important;min-height:unset!important;overflow-wrap:anywhere;text-align:left;width:100%}.billing-invoice-card.selected{border-color:#171717!important;box-shadow:inset 0 -3px #e53b7d}.billing-invoice-card span{font-size:.85rem}.billing-card-total{font-weight:700}.billing-job-card,.billing-payment{background:white;border:1px solid #ded8d0;display:grid;gap:6px;margin:8px 0;min-width:0;overflow-wrap:anywhere;padding:12px}.billing-job-card>strong,.billing-payment>strong{font-size:.95rem}.billing-exception{border-top:1px solid #ded8d0;margin-top:12px;padding-top:12px}.billing-exception summary{cursor:pointer;font-weight:750;min-height:44px;padding:9px 0}.billing-detail-heading{border-bottom:1px solid #ded8d0;margin-bottom:12px;overflow-wrap:anywhere;padding-bottom:8px}.billing-detail-heading>div{font-family:'Space Grotesk',sans-serif;font-size:1.35rem;font-weight:750}.billing-detail-heading p,.billing-identity p{margin:5px 0;overflow-wrap:anywhere}.billing-identity,.billing-notice{background:#f4efe8;border-left:3px solid #c8b9aa;margin:12px 0;overflow-wrap:anywhere;padding:10px 12px}.billing-lines,.billing-totals,.billing-payment-form,.billing-payments{border-top:1px solid #ded8d0;margin-top:18px;padding-top:14px}.billing-line{background:white;border:1px solid #ded8d0;margin:10px 0;min-width:0;overflow-wrap:anywhere;padding:12px}.billing-line-title{align-items:start;display:flex;flex-wrap:wrap;gap:6px 12px;justify-content:space-between;margin-bottom:8px}.billing-line-title span{color:#655f59;font-size:.78rem}.billing-form-grid{display:grid;gap:10px;grid-template-columns:repeat(3,minmax(0,1fr));margin:10px 0}.billing-check{align-items:flex-start!important;display:flex!important;gap:9px!important;margin:9px 0}.billing-check input{flex:0 0 20px;height:20px;margin:1px 0;min-height:20px;width:20px}.billing-check span{font-weight:600!important}.billing-line-total{font-weight:750;margin:9px 0 0}.billing-manual-form{background:white;border:1px solid #ded8d0;margin:16px 0;padding:14px}.billing-manual-form h3{font-size:1rem;margin:0}.billing-span{grid-column:1/-1}.billing-total-row{display:flex;gap:12px;justify-content:space-between;margin:6px 0;overflow-wrap:anywhere}.billing-total-row.grand{border-top:2px solid #171717;font-size:1.15rem;margin-top:10px;padding-top:10px}.billing-actions{display:flex;flex-wrap:wrap;gap:9px;margin:16px 0}.billing-financial-status{background:#eaf4ea;border:1px solid #8ab28d;font-weight:750;overflow-wrap:anywhere;padding:12px}.billing-discrepancy,.billing-exception-note{background:#fff1ed;border:1px solid #a82d25;color:#6e1c18;margin:14px 0;overflow-wrap:anywhere;padding:12px}.billing-issued-line,.billing-empty{overflow-wrap:anywhere}.billing-payment{grid-template-columns:minmax(0,1fr) auto;align-items:center}.billing-payment>*{min-width:0;overflow-wrap:anywhere}.billing-payment button{grid-column:1/-1}.billing-payment-form button,.billing-manual-form button{margin-top:10px}.billing-workbench button:focus-visible{outline:3px solid #1769aa;outline-offset:3px}.billing-workbench .field-error{background:#fff1ed;margin:10px 0;padding:10px}.billing-workbench [hidden]{display:none!important}
  @media(max-width:760px){.billing-columns{grid-template-columns:minmax(0,1fr)}.billing-form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:520px){.billing-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.billing-form-grid{grid-template-columns:minmax(0,1fr)}.billing-actions>*{flex:1 1 100%;width:100%}.billing-payment{grid-template-columns:minmax(0,1fr)}}
  @media print{.billing-workbench,.billing-jobs-panel{display:none!important}}
</style>
<script>
  import { mountWorkshopPage } from '../../../../components/workshop/operations.ts';
  mountWorkshopPage(document.querySelector<HTMLElement>('#main')!);
</script>

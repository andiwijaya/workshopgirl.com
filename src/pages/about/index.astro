---
import ShareButton from '../../components/ShareButton.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';

const title = 'About WorkshopGirl | Learn, Fix, Build & Explore';
const description = 'Meet WorkshopGirl, a practical learning site about machines, tools, repairs and projects — guided by Workshop Girl, our fictional workshop host.';
const canonical = 'https://workshopgirl.com/about/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://workshopgirl.com/images/about/workshopgirl-about-hero.webp?v=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{title}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
      :root { --ink:#171717; --muted:#655f59; --paper:#f7f4ef; --pink:#e53b7d; --orange:#e58445; --line:#ded8d0; --soft:#fffaf4; } * { box-sizing:border-box; } html { background:var(--paper); color:var(--ink); font-family:'DM Sans',sans-serif; } body { margin:0; min-width:320px; } a { color:inherit; }
      .shell { min-height:100vh; overflow:hidden; position:relative; } .shell::before { content:''; position:absolute; inset:0; pointer-events:none; opacity:.22; background-image:radial-gradient(#b8afa4 .7px,transparent .7px); background-size:18px 18px; mask-image:linear-gradient(to bottom,black,transparent 72%); }
      main { margin:0 auto; max-width:1280px; padding:7vh 5vw 9vh; position:relative; z-index:1; } .hero { align-items:center; display:grid; gap:clamp(32px,6vw,90px); grid-template-columns:minmax(280px,.82fr) minmax(360px,1.18fr); } .eyebrow,.kicker { color:var(--pink); font-size:.78rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; } h1,h2,h3 { font-family:'Space Grotesk',sans-serif; letter-spacing:-.065em; } h1 { font-size:clamp(3.4rem,6.8vw,6.6rem); line-height:.91; margin:22px 0 26px; max-width:620px; } .hero-copy p,.section p { color:var(--muted); font-size:1.08rem; line-height:1.75; max-width:620px; } .hero-image { margin:0; } .hero-image img { display:block; height:auto; width:100%; } figcaption { color:var(--muted); font-size:.82rem; margin-top:11px; }
      .actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:28px; } .button { background:var(--ink); color:#fff; display:inline-block; font-weight:700; padding:14px 19px; text-decoration:none; } .button.secondary { background:transparent; border:1px solid var(--ink); color:var(--ink); } .button:hover,.button:focus-visible { background:var(--pink); border-color:var(--pink); color:#fff; }
      .section { border-top:1px solid var(--line); margin-top:100px; padding-top:52px; } h2 { font-size:clamp(2.2rem,4vw,4rem); line-height:1; margin:0 0 20px; } .narrow { max-width:790px; } .note { background:var(--soft); border-left:4px solid var(--pink); margin-top:28px; padding:23px 25px; } .note p { margin:0; }
      .values { display:grid; gap:16px; grid-template-columns:repeat(5,1fr); margin-top:32px; } .value,.find-card { background:var(--soft); border:1px solid var(--line); padding:23px; } .value h3,.find-card h3 { font-size:1.35rem; margin:0 0 10px; } .value p,.find-card p { font-size:.95rem; margin:0; }
      .find-grid { display:grid; gap:16px; grid-template-columns:repeat(4,1fr); margin-top:32px; } .find-card { display:flex; flex-direction:column; } .find-card a,.find-card .coming { color:var(--pink); font-size:.86rem; font-weight:700; margin-top:auto; padding-top:22px; text-decoration:none; } .find-card a:hover,.find-card a:focus-visible { color:var(--ink); } .coming { color:var(--muted)!important; }
      .principle { border-left:4px solid var(--orange); margin-top:25px; padding-left:24px; } .share-section { align-items:center; display:flex; gap:28px; justify-content:space-between; } .share-section h2 { font-size:clamp(1.8rem,3vw,2.8rem); margin:0; } :focus-visible { outline:3px solid var(--pink); outline-offset:4px; }
      @media (max-width:900px) { .hero { grid-template-columns:1fr; } .hero-copy { max-width:720px; } .hero-image { max-width:760px; } .values { grid-template-columns:repeat(2,1fr); } .find-grid { grid-template-columns:repeat(2,1fr); } }
      @media (max-width:700px) { main { padding:7vh 7vw 10vh; } h1 { font-size:clamp(3rem,14vw,5.5rem); } .hero { gap:34px; } .hero-image { order:2; } .hero-copy { order:1; } .section { margin-top:70px; padding-top:38px; } .values,.find-grid { grid-template-columns:1fr; } .actions { align-items:stretch; flex-direction:column; } .button { text-align:center; } .share-section { align-items:flex-start; flex-direction:column; gap:18px; } }
    </style>
  </head>
  <body><div class="shell"><SiteHeader current="about" /><main>
    <section class="hero" aria-labelledby="about-title"><div class="hero-copy"><div class="eyebrow">About WorkshopGirl</div><h1>Real Machines.<br />Real Skills.<br /><span style="color:var(--pink)">Better Days.</span></h1><p>WorkshopGirl is a place for people who like learning how things work — and aren’t afraid to get their hands a little dirty.</p><p>Cars, bikes, tools, electrical systems, workshop projects and practical skills all belong here.</p><div class="actions"><a class="button" href="/tutorials/">Explore tutorials</a><a class="button secondary" href="/diary/">Read the diary</a></div></div><figure class="hero-image"><img src="/images/about/workshopgirl-about-hero.webp?v=1" alt="Workshop Girl standing in her workshop surrounded by a car, motorcycle, workbench and practical tools." width="1672" height="941" fetchpriority="high" /><figcaption>A workshop is a good place to start asking better questions.</figcaption></figure></section>
    <section class="section narrow"><div class="kicker">The point of the work</div><h2>Why WorkshopGirl Exists</h2><p>A lot of machines look intimidating until someone slows down and explains what is actually happening. WorkshopGirl exists to make practical engineering, maintenance and workshop skills easier to approach.</p><p>The goal isn’t to pretend every job is easy. It is to make the first step less intimidating: understand before memorizing, learn through real machines, build practical confidence, respect safety, and know when professional help is the better choice.</p></section>
    <section class="section narrow"><div class="kicker">The familiar face</div><h2>Meet Workshop Girl</h2><p>Workshop Girl is the fictional host of WorkshopGirl.com — the recurring face across our tutorials, projects and workshop stories. She’s curious, practical, persistent, and perfectly capable of admitting when a five-minute job turns into an afternoon.</p><p>She isn’t here because she already knows everything. She’s here because figuring things out is the interesting part.</p><div class="note"><p>Workshop Girl is a fictional / virtual character, not a real mechanic or engineer. The learning, questions and workshop lessons are the point.</p></div></section>
    <section class="section"><div class="kicker">The WorkshopGirl way</div><h2>Learn · Fix · Build · Play · Explore</h2><div class="values"><div class="value"><h3>Learn</h3><p>Understand how machines and systems actually work.</p></div><div class="value"><h3>Fix</h3><p>Build confidence with practical maintenance, troubleshooting and repair skills.</p></div><div class="value"><h3>Build</h3><p>Follow projects from the first idea to the finished result.</p></div><div class="value"><h3>Play</h3><p>Experiment, make mistakes and enjoy figuring things out.</p></div><div class="value"><h3>Explore</h3><p>Follow curiosity into new machines, tools and technologies.</p></div></div></section>
    <section class="section"><div class="kicker">A place to begin</div><h2>What You’ll Find Here</h2><div class="find-grid"><div class="find-card"><h3>Tutorials</h3><p>Practical step-by-step guides for learning useful workshop skills.</p><a href="/tutorials/">Explore tutorials →</a></div><div class="find-card"><h3>Diary</h3><p>The less polished side of learning — stubborn machines, mistakes, experiments and lessons from the workshop.</p><a href="/diary/">Read the diary →</a></div><div class="find-card"><h3>Projects</h3><p>Longer builds and repair journeys from beginning to end.</p><span class="coming">Coming next.</span></div><div class="find-card"><h3>Tools &amp; Machines</h3><p>Tools and machines appear when they help readers understand or complete real work.</p><span class="coming">Follow the work.</span></div></div></section>
    <section class="section narrow"><div class="kicker">A working principle</div><h2>Practical Doesn’t Mean Careless</h2><p>WorkshopGirl aims to explain why something works, distinguish general principles from vehicle-specific procedures, prioritize safe working practices, and avoid inventing universal torque values or service specifications.</p><p>When exact specifications matter, the right source is manufacturer documentation. And when a job is beyond a safe learning exercise, professional help is the better choice.</p></section>
    <section class="section narrow"><div class="kicker">The honest version</div><h2>The Workshop Is Allowed to Be Messy</h2><p>Things don’t always work the first time. Bolts get stuck. Tools turn out to be wrong. Five-minute jobs become two-hour jobs. That’s part of learning.</p><p>For one very stubborn example, read <a href="/diary/the-first-bolt-i-couldnt-remove/">The First Bolt I Couldn’t Remove</a>.</p></section>
    <section class="section narrow"><div class="kicker">Your next move</div><h2>Start Somewhere</h2><p>You don’t need to know everything before you pick up the first tool. Choose a skill. Understand the job. Work safely. Learn one machine at a time.</p><div class="actions"><a class="button" href="/tutorials/">Explore tutorials</a><a class="button secondary" href="/diary/">Read the diary</a></div></section>
    <section class="section share-section" aria-label="Share WorkshopGirl"><h2>Share WorkshopGirl</h2><ShareButton title="About WorkshopGirl" canonical={canonical} label="Share this page" /></section>
  </main><SiteFooter /></div></body>
</html>

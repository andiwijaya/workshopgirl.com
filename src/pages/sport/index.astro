---
import { sportActivities } from '../../data/sport';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const title = 'Sport | WorkshopGirl';
const description = "Workshop Girl doesn't stay in the workshop. Explore climbing, training and new physical skills learned by getting out there and trying.";
const canonical = 'https://workshopgirl.com/sport/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://workshopgirl.com/images/sport/rock-climbing/workshopgirl-indoor-rock-climbing.webp" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content="https://workshopgirl.com/images/sport/rock-climbing/workshopgirl-indoor-rock-climbing.webp" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{title}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
      :root { --ink:#171717; --muted:#655f59; --paper:#f7f4ef; --pink:#e53b7d; --line:#ded8d0; --soft:#fffaf4; } * { box-sizing:border-box; } html { background:var(--paper); color:var(--ink); font-family:'DM Sans',sans-serif; } body { margin:0; min-width:0; } a { color:inherit; }
      .shell { min-height:100vh; overflow:hidden; position:relative; } .shell::before { content:''; position:absolute; inset:0; pointer-events:none; opacity:.22; background-image:radial-gradient(#b8afa4 .7px,transparent .7px); background-size:18px 18px; mask-image:linear-gradient(to bottom,black,transparent 75%); }
      main { margin:0 auto; max-width:1180px; padding:9vh 5vw 12vh; position:relative; z-index:1; } .intro { max-width:720px; } .eyebrow,.category { color:var(--pink); font-size:.78rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; } h1,h2 { font-family:'Space Grotesk',sans-serif; letter-spacing:-.07em; } h1 { font-size:clamp(3.5rem,8vw,7rem); line-height:.9; margin:22px 0; } .lead { color:var(--muted); font-size:clamp(1.08rem,2vw,1.25rem); line-height:1.7; max-width:660px; }
      .rule { border:0; border-top:1px solid var(--line); margin:58px 0 26px; } .section-label { color:var(--muted); font-size:.8rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; } .card { background:var(--soft); border:1px solid var(--line); display:grid; grid-template-columns:minmax(320px,1.15fr) 1fr; margin-top:18px; text-decoration:none; } .card img { display:block; height:auto; width:100%; } .card-copy { align-self:center; padding:clamp(26px,5vw,64px); } h2 { font-size:clamp(2rem,4vw,3.4rem); line-height:1; margin:14px 0; } .card p { color:var(--muted); line-height:1.7; } .date { color:var(--muted); font-size:.85rem; } .button { background:var(--ink); color:#fff; display:inline-block; font-weight:700; margin-top:18px; padding:13px 19px; } .card:hover .button,.card:focus-visible .button { background:var(--pink); } :focus-visible { outline:3px solid var(--pink); outline-offset:4px; }
      @media(max-width:700px) { main { padding:7vh 7vw 10vh; } .card { display:block; } .card-copy { padding:25px 22px 30px; } }
    </style>
  </head>
  <body><div class="shell"><SiteHeader current="sport" /><main>
    <section class="intro"><div class="eyebrow">Move · explore · learn</div><h1>Sport.</h1><p class="lead">New skills aren't only learned at a workbench. Sometimes the best way to understand movement, balance and control is to get out there and try.</p></section>
    <hr class="rule" /><div class="section-label">Latest activity</div>
    {sportActivities.map((activity) => <a class="card" href={activity.slug}>
      <img src={activity.image} alt={activity.imageAlt} width="1672" height="941" fetchpriority="high" />
      <div class="card-copy"><div class="category">{activity.category}</div><h2>{activity.title}</h2><p>{activity.excerpt}</p><div class="date">{activity.published}</div><span class="button">See the activity →</span></div>
    </a>)}
  </main><SiteFooter /></div></body>
</html>

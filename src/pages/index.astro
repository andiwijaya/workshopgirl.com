---
import { tutorials } from '../data/tutorials';
import { diaryEntries } from '../data/diary';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Workshop Girl — Build. Fix. Learn.';
const description = 'Follow Workshop Girl as she builds, fixes, experiments and learns through engines, electrical work, HVAC, woodworking and practical engineering projects.';
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const featuredTutorial = tutorials[0];
const previousTutorial = tutorials[1];
const latestDiary = diaryEntries[0];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://workshopgirl.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://workshopgirl.com/" />
    <meta property="og:image" content="https://workshopgirl.com/images/workshop-girl/workshop-girl-hero.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>}
    <style>
      @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
      :root { --ink:#171717; --muted:#655f59; --paper:#f7f4ef; --pink:#e53b7d; --orange:#e58445; --line:#ded8d0; }
      * { box-sizing:border-box; }
      html { background:var(--paper); color:var(--ink); font-family:'DM Sans', sans-serif; }
      body { margin:0; min-width:320px; }
      a { color:inherit; }
      .shell { min-height:100vh; overflow:hidden; position:relative; }
      .shell::before { content:''; position:absolute; inset:0; pointer-events:none; opacity:.22; background-image:radial-gradient(#b8afa4 0.7px,transparent .7px); background-size:18px 18px; mask-image:linear-gradient(to bottom,black,transparent 75%); }
      header { align-items:center; display:flex; justify-content:space-between; margin:0 auto; max-width:1280px; padding:30px 5vw; position:relative; z-index:2; }
      .brand { font-family:'Space Grotesk',sans-serif; font-size:1.2rem; font-weight:700; letter-spacing:-.04em; text-decoration:none; }
      .brand span { color:var(--pink); }
      nav { display:flex; gap:24px; }
      nav a { color:var(--muted); font-size:.9rem; text-decoration:none; }
      nav a:hover, nav a:focus-visible { color:var(--pink); }
      main { display:grid; grid-template-columns:minmax(320px, .82fr) minmax(420px, 1.18fr); gap:clamp(16px,5vw,90px); margin:0 auto; max-width:1280px; min-height:calc(100vh - 94px); padding:5vh 5vw 7vh; position:relative; z-index:1; }
      .copy { align-self:center; max-width:510px; padding-bottom:5vh; }
      .eyebrow { align-items:center; color:var(--pink); display:flex; font-size:.83rem; font-weight:700; gap:10px; letter-spacing:.14em; text-transform:uppercase; }
      .eyebrow::before { background:var(--pink); content:''; height:2px; width:34px; }
      h1 { font-family:'Space Grotesk',sans-serif; font-size:clamp(3.5rem,6.4vw,6.8rem); letter-spacing:-.075em; line-height:.92; margin:28px 0 26px; max-width:650px; }
      h1 em { color:var(--pink); font-style:normal; }
      .intro { color:var(--muted); font-size:clamp(1.05rem,1.5vw,1.3rem); line-height:1.65; max-width:420px; }
      .intro strong { color:var(--ink); font-weight:600; }
      .status { align-items:center; border-top:1px solid var(--line); display:flex; gap:14px; margin-top:42px; max-width:400px; padding-top:18px; }
      .dot { background:var(--pink); border-radius:50%; box-shadow:0 0 0 6px #f5d8e4; height:11px; width:11px; }
      .status div { font-size:.95rem; font-weight:600; }
      .status small { color:var(--muted); display:block; font-size:.8rem; font-weight:400; margin-top:3px; }
      .portrait { align-self:end; justify-self:center; max-height:calc(100vh - 115px); position:relative; }
      .portrait::after { background:var(--orange); border-radius:50%; content:''; height:clamp(200px,25vw,370px); opacity:.23; position:absolute; right:-12%; top:15%; width:clamp(200px,25vw,370px); z-index:-1; }
      .portrait img { display:block; filter:saturate(.95); height:auto; max-height:calc(100vh - 115px); max-width:100%; object-fit:contain; width:auto; }
      .note { bottom:8%; color:var(--muted); font-family:'Space Grotesk',sans-serif; font-size:.86rem; position:absolute; right:7%; transform:rotate(-7deg); }
      .note span { color:var(--pink); font-size:1.4rem; }
      .featured { border-top:1px solid var(--line); margin:0 auto; max-width:1280px; padding:32px 5vw 72px; position:relative; z-index:1; }
      .featured-inner { align-items:center; background:#fffaf4; border:1px solid var(--line); display:grid; grid-template-columns:190px 1fr auto; gap:24px; padding:16px; }
      .featured img { display:block; height:128px; object-fit:cover; width:190px; }
      .featured-label { color:var(--pink); font-size:.74rem; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
      .featured h2 { font-family:'Space Grotesk',sans-serif; font-size:clamp(1.2rem,2vw,1.65rem); letter-spacing:-.04em; margin:7px 0; }
      .featured p { color:var(--muted); line-height:1.5; margin:0; max-width:560px; }
      .featured a { background:var(--ink); color:#fff; display:inline-block; font-size:.9rem; font-weight:700; padding:12px 16px; text-decoration:none; white-space:nowrap; }
      .featured a:hover, .featured a:focus-visible { background:var(--pink); }
      .featured-next { color:var(--muted); font-size:.9rem; margin:18px 0 0; text-align:right; }
      .featured-next a { background:none; color:var(--ink); padding:0; text-decoration:underline; white-space:normal; }
      .featured-next a:hover, .featured-next a:focus-visible { background:none; color:var(--pink); }
      .from-workshop { border-top:1px solid var(--line); margin:0 auto; max-width:1280px; padding:64px 5vw 96px; position:relative; z-index:1; }
      .from-workshop-heading { align-items:end; display:flex; justify-content:space-between; gap:24px; margin-bottom:24px; }
      .from-workshop-heading h2 { font-family:'Space Grotesk',sans-serif; font-size:clamp(2rem,4vw,3.6rem); letter-spacing:-.06em; line-height:1; margin:8px 0 0; }
      .from-workshop-heading p { color:var(--muted); margin:0 0 5px; }
      .diary-card { background:#fffaf4; border:1px solid var(--line); display:grid; grid-template-columns:minmax(300px,1.12fr) 1fr; }
      .diary-card img { display:block; height:100%; min-height:320px; object-fit:cover; width:100%; }
      .diary-card-copy { align-self:center; padding:clamp(26px,5vw,68px); }
      .diary-card h3 { font-family:'Space Grotesk',sans-serif; font-size:clamp(2rem,4vw,3.4rem); letter-spacing:-.06em; line-height:1; margin:14px 0; }
      .diary-card p { color:var(--muted); font-size:1.05rem; line-height:1.65; }
      .diary-card a { background:var(--ink); color:#fff; display:inline-block; font-weight:700; margin-top:14px; padding:13px 18px; text-decoration:none; }
      .diary-card a:hover, .diary-card a:focus-visible { background:var(--pink); }
      @media (max-width: 760px) {
        header { padding:22px 7vw; }
        nav { gap:14px; }
        nav a:nth-child(n+3) { display:none; }
        main { display:flex; flex-direction:column; gap:10px; min-height:auto; padding:7vh 7vw 0; }
        .copy { padding:0; }
        h1 { font-size:clamp(3.5rem,16vw,5.6rem); margin-top:22px; }
        .intro { font-size:1.05rem; }
        .status { margin-top:28px; }
        .portrait { align-self:center; margin-top:20px; max-height:none; width:min(100%,460px); }
        .portrait img { max-height:none; width:100%; }
        .note { bottom:9%; right:2%; }
        .featured { padding:28px 7vw 56px; }
        .featured-inner { display:block; padding:14px; }
        .featured img { height:auto; width:100%; }
        .featured h2 { font-size:1.7rem; line-height:1.05; }
        .featured p { font-size:.98rem; }
        .featured a { margin-top:18px; }
        .from-workshop { padding:34px 7vw 64px; }
        .from-workshop-heading { display:block; }
        .from-workshop-heading p { margin-top:12px; }
        .diary-card { display:block; }
        .diary-card img { height:auto; min-height:0; }
        .diary-card-copy { padding:28px 22px 30px; }
        .diary-card h3 { font-size:2rem; }
      }
      @media (prefers-reduced-motion: no-preference) {
        .portrait img { animation: arrive .8s cubic-bezier(.2,.8,.2,1) both; }
        @keyframes arrive { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:none; } }
      }
      :focus-visible { outline:3px solid var(--pink); outline-offset:4px; }
    </style>
  </head>
  <body>
    <div class="shell">
      <SiteHeader current="home" />
      <main>
        <section class="copy" id="coming-soon">
          <div class="eyebrow">The workshop is opening soon</div>
          <h1>Hi, I'm<br /><em>Workshop Girl.</em></h1>
          <p class="intro"><strong>I fix things, build things, break things...</strong><br />and sometimes figure out why.</p>
          <div class="status"><span class="dot" aria-hidden="true"></span><div>WorkshopGirl.com<small>Engines, electrical, HVAC, woodworking & practical projects.</small></div></div>
        </section>
        <figure class="portrait">
          <img src="/images/workshop-girl/workshop-girl-hero.png" alt="Workshop Girl in her workshop holding a wrench and toolbox" width="1024" height="1536" fetchpriority="high" />
          <figcaption class="note">Real machines.<br />Real skills.<br /><span>♥</span></figcaption>
        </figure>
      </main>
      <section class="featured" aria-labelledby="featured-title">
        <div class="featured-inner">
          <img src={featuredTutorial.image} alt={featuredTutorial.imageAlt} width="1672" height="941" loading="lazy" />
          <div>
            <div class="featured-label">Latest tutorial · {featuredTutorial.category}</div>
            <h2 id="featured-title">{featuredTutorial.title}</h2>
            <p>{featuredTutorial.description}</p>
          </div>
          <a href={featuredTutorial.slug}>Read tutorial</a>
        </div>
        <p class="featured-next">Next workshop skill: <a href={previousTutorial.slug}>{previousTutorial.title}</a></p>
      </section>
      <section class="from-workshop" aria-labelledby="diary-title">
        <div class="from-workshop-heading">
          <div><div class="featured-label">From the workshop</div><h2 id="diary-title">Stories behind the work.</h2></div>
          <p>Not every repair goes according to plan.</p>
        </div>
        <article class="diary-card">
          <img src={latestDiary.image} alt={latestDiary.imageAlt} width="1672" height="941" loading="lazy" />
          <div class="diary-card-copy"><div class="featured-label">Diary · {latestDiary.published}</div><h3>{latestDiary.title}</h3><p>{latestDiary.excerpt}</p><a href={latestDiary.slug}>Read the diary</a></div>
        </article>
      </section>
    </div>
  </body>
</html>

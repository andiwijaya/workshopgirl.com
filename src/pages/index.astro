---
import DiscoveryLayout from '../components/DiscoveryLayout.astro';
import { featuredLearning, latestContent } from '../data/home-feed.ts';
import { availableLearnCategories } from '../data/learn.ts';
const categories = availableLearnCategories();
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
<DiscoveryLayout title="Workshop Girl - Build. Fix. Learn." description="What do you need to do today? Observe a sound, learn a practical repair, or start a local workshop job with Workshop Girl." canonical="https://workshopgirl.com/" image="https://workshopgirl.com/images/workshop-girl/workshop-girl-hero.png">
  {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
  {gaId && <script is:inline define:vars={{ gaId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    // Homepage analytics must not forward local job IDs or arbitrary query data
    // from a previous tool page (or this page's URL).
    let publicReferrer = '';
    try { const referrer = new URL(document.referrer); publicReferrer = referrer.origin + referrer.pathname; } catch { /* No referrer. */ }
    gtag('js', new Date()); gtag('config', gaId, {
      page_location: 'https://workshopgirl.com/', page_referrer: publicReferrer,
      allow_google_signals: false, allow_ad_personalization_signals: false,
    });
  </script>}
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy"><div class="eyebrow">Your digital workshop companion</div><h1 id="home-title">What needs<br /><em>working on?</em></h1><p class="lead">Hi, I'm Workshop Girl. I fix things, build things, break things… and sometimes figure out why. Let's make a useful next step.</p>
      <div class="hero-actions"><a class="action" href="/tools/engine-sound-analyzer/">Observe an engine sound</a><a class="action secondary" href="/tutorials/">Learn / fix something</a><a class="action secondary" href="/tools/workshop/vehicle-intake/">Start a Workshop Job</a></div>
    </div>
    <figure class="portrait"><img src="/images/workshop-girl/workshop-girl-hero-800.webp" srcset="/images/workshop-girl/workshop-girl-hero-480.webp 480w, /images/workshop-girl/workshop-girl-hero-800.webp 800w" sizes="(max-width: 760px) 86vw, 42vw" alt="Workshop Girl in her workshop holding a wrench and toolbox" width="800" height="1200" fetchpriority="high" /><figcaption>Real machines. Real skills.</figcaption></figure>
  </section>
  <section id="analyze" aria-labelledby="analyze-title"><div class="eyebrow">Listen. Compare. Investigate.</div><h2 id="analyze-title">Take a closer look at a sound.</h2><p>Browser tools for observations and comparisons. A spectrum does not identify a mechanical fault.</p><div class="card-grid analyzer-links">
    <a class="discovery-card" href="/tools/engine-sound-analyzer/"><h3>Engine Sound Analyzer</h3><p>Engine sounds unusual? Observe peaks and compare captures with optional RPM references.</p><strong>Open Engine Sound Analyzer →</strong></a>
    <a class="discovery-card" href="/tools/sound-analyzer/"><h3>Sound Analyzer</h3><p>Inspect a live sound or local audio file through its waveform, spectrum and spectrogram.</p><strong>Open Sound Analyzer →</strong></a>
    <a class="discovery-card" href="/tools/speaker-sound-analyzer/"><h3>Speaker Sound Analyzer</h3><p>Explore the bass, mid and treble balance of the sound your microphone captures.</p><strong>Open Speaker Sound Analyzer →</strong></a>
  </div></section>
  <section id="learn" aria-labelledby="learn-title"><div class="eyebrow">A useful skill for the next job</div><h2 id="learn-title">Learn / fix something.</h2><nav class="category-links" aria-label="Practical learning categories">{categories.map(category => <a href={'/tutorials/#' + category.id}>{category.label}</a>)}</nav><div class="card-grid learning-cards">{featuredLearning.map(item => <article class="discovery-card"><img src={item.image} alt={item.imageAlt} width="1672" height="941" loading="lazy" /><h3>{item.title}</h3><p>{item.description}</p><a href={item.slug}>Read the guide</a></article>)}</div></section>
  <section class="workshop-entry" id="workshop" aria-labelledby="workshop-title"><div class="eyebrow">Run a workshop job</div><h2 id="workshop-title">One job. Keep it connected.</h2><p>From arrival and inspection to agreed work, QC and handover. Local records, right here in your browser.</p><div class="actions"><a class="action" href="/tools/workshop/vehicle-intake/">Start a Workshop Job</a><a class="action secondary" href="/tools/workshop/queue/">Resume Queue</a></div><div class="category-links"><a href="/workshop/">Explore Workshop</a><a href="/tools/workshop/parts-inventory/">Parts</a><a href="/tools/workshop/billing/">Billing</a><a href="/tools/workshop/service-history/">Service History</a></div></section>
  <section id="latest" aria-labelledby="latest-title"><div class="eyebrow">Fresh from the bench and beyond</div><h2 id="latest-title">Latest from Workshop Girl.</h2><div class="card-grid">{latestContent.map(item => <article class="discovery-card"><img src={item.image} alt={item.imageAlt} width="1672" height="941" loading="lazy" /><p class="eyebrow">{item.kind}</p><h3>{item.title}</h3><time datetime={item.publishedAt}>{item.published}</time><p>{item.excerpt}</p><a href={item.slug}>{item.actionLabel}</a></article>)}</div><p><a href="/stories/">More stories and projects</a> · <a href="/tutorials/">All learning guides</a></p></section>
</DiscoveryLayout>
<style>
  .home-hero{display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:30px;margin-top:0}.hero-copy{min-width:0}.home-hero h1{font-size:clamp(3.2rem,5.5vw,5.8rem);letter-spacing:-.065em}.home-hero em{color:#ab2457;font-style:normal}.hero-actions{display:flex;flex-direction:column;align-items:flex-start;gap:12px;margin-top:24px}.portrait{margin:0;position:relative}.portrait img{display:block;width:100%;height:auto;aspect-ratio:2/3;object-fit:contain;border-radius:100px 100px 6px 6px}.portrait figcaption{position:absolute;bottom:22px;right:12px;background:var(--soft);padding:14px;transform:rotate(-4deg);font-family:'Space Grotesk',sans-serif;font-weight:700}.analyzer-links a{text-decoration:none}.analyzer-links a:hover{border-color:#ab2457}.learning-cards{margin-top:24px}.workshop-entry{padding:30px;background:#fffaf4;border-top:3px solid var(--orange)}
  @media(max-width:760px){.home-hero{grid-template-columns:1fr;gap:26px}.home-hero h1{font-size:clamp(3rem,12vw,4.5rem)}.hero-actions{align-items:stretch}.portrait{max-width:320px;width:100%;margin:auto}.portrait img{height:auto;border-radius:65px 65px 6px 6px}.portrait figcaption{font-size:.9rem;bottom:15px}.workshop-entry{padding:22px}.category-links{gap:10px}.category-links a{font-size:.9rem}}
</style>

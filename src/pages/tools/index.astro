---
import LocalJobContext from '../../components/LocalJobContext.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/sound-analyzer.css';
const title = 'Digital Workbench — Browser Tools | WorkshopGirl';
const description = 'The WorkshopGirl Digital Workbench: measure and annotate photos, analyze sound, inspect engine and speaker observations, and validate DSP locally in your browser. Workshop jobs, parts and billing have their own connected Workshop.';
---
<!doctype html><html lang="en"><head><LocalJobContext /><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href="https://workshopgirl.com/tools/" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content="https://workshopgirl.com/tools/" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /></head><body><SiteHeader current="tools" /><main><div class="hero"><span class="eyebrow">WorkshopGirl tools</span><h1>The digital <span>workbench.</span></h1><p>Practical tools for a closer look at the machines and sounds around you.</p></div>
  <section class="tool-category" id="diagnostics" aria-labelledby="diagnostics-heading"><h2 id="diagnostics-heading">Diagnose &amp; Analyze</h2><div class="tool-grid">
    <a class="tool-card" href="/tools/sound-analyzer/"><span class="eyebrow">Audio / locally in your browser</span><h2>Sound Analyzer</h2><p>Live microphone or audio file. Waveform, frequency spectrum, spectrogram and a useful before/after comparison.</p><strong>Open Sound Analyzer →</strong></a>
    <a class="tool-card" href="/tools/engine-sound-analyzer/"><span class="eyebrow">Engine sound / Live measurement</span><h2>Engine Sound Analyzer</h2><p>Inspect harmonics and persistent peaks with optional RPM and firing references. Capture before/after snapshots while live, without recording.</p><strong>Open Engine Sound Analyzer →</strong></a>
    <a class="tool-card" href="/tools/speaker-sound-analyzer/"><span class="eyebrow">Music / Captured frequency balance</span><h2>Speaker Sound Analyzer</h2><p>Play music. See its frequency balance. Explore bass, mid and treble with a simple captured sound profile.</p><strong>Open Speaker Sound Analyzer →</strong></a>
    <a class="tool-card" href="/tools/dsp-validation/"><span class="eyebrow">Audio / Validation utility</span><h2>DSP Validation Workbench</h2><p>Inspect and validate the digital signal processing pipeline with known signals and repeatable checks.</p><strong>Open DSP Validation →</strong></a>
  </div></section>
  <section class="tool-category" id="measure-build" aria-labelledby="measure-build-heading"><h2 id="measure-build-heading">Measure &amp; Build</h2><div class="tool-grid"><a class="tool-card" href="/tools/photo-measurement/"><span class="eyebrow">Photos / locally in your browser</span><h2>Photo Measurement Lab</h2><p>Calibrate a known reference, correct a rectangular plane, measure dimensions and annotate your work. Export PNG and JSON locally.</p><strong>Open Photo Measurement Lab →</strong></a></div></section>
  <section class="tool-category workshop-category" id="workshop-operations" aria-labelledby="operations-heading"><p class="eyebrow">Looking for your jobs?</p><h2 id="operations-heading">Workshop Operations live in Workshop.</h2><p>Start or resume a local job, then move through inspection, work and handover. Parts, procurement, billing and history support the work when needed.</p><a class="button-link" href="/workshop/">Open Workshop</a></section><p>Build your understanding with our <a href="/tutorials/">workshop tutorials</a>.</p></main><SiteFooter /><style>.tool-category{margin:3rem auto;max-width:1100px;padding:0 1rem}.tool-category>h2{font-size:clamp(1.7rem,4vw,2.4rem);margin:.25rem 0 1rem}.tool-category>p:not(.eyebrow){max-width:60ch}.tool-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:1rem}.tool-card{display:block}.workshop-category{border-top:1px solid #ddd;padding-top:2rem}.tool-card h3{font-size:1.35rem}</style></body></html>

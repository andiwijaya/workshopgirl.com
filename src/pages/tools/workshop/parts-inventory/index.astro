---
import WorkshopLayout from '../../../../components/workshop/WorkshopLayout.astro';
const path='/tools/workshop/parts-inventory/';
const title='Parts Inventory | WorkshopGirl Workshop Operations';
const description='Manage browser-local workshop parts, stock movements and job-linked issues with an auditable inventory ledger.';
---
<WorkshopLayout title={title} description={description} canonical={`https://workshopgirl.com${path}`} step="parts-inventory" heading="Parts Inventory" intro="Track stock with a movement ledger and connect issued parts to the same Workshop Job. Inventory stays in this browser.">
  <section class="workshop-card parts-panel" aria-labelledby="parts-title"><h2 id="parts-title">Parts catalog</h2><div class="parts-toolbar"><label>Search parts<input id="part-search" type="search" placeholder="Name, SKU, category or location" /></label><label>Filter<select id="part-filter"><option value="all">Active parts</option><option value="low">Low stock</option><option value="out">Out of stock</option><option value="inactive">Inactive parts</option></select></label><label>Sort<select id="part-sort"><option value="name">Name</option><option value="stock">Lowest stock</option><option value="recent">Recently updated</option></select></label></div><div id="parts-list" class="parts-list" aria-live="polite"></div></section>
  <section class="workshop-card parts-panel" aria-labelledby="part-form-title"><h2 id="part-form-title">Create or edit a part</h2><form id="part-form" class="parts-form"><input type="hidden" name="id" /><label>Part name<input name="name" required /></label><label>SKU / part number<input name="sku" /></label><label>Category<input name="category" /></label><label>Brand<input name="brand" /></label><label>Unit<input name="unit" value="each" required /></label><label>Storage location<input name="location" /></label><label>Supplier reference (legacy note)<input name="supplier" /></label><label>Default Supplier (suggestion)<select name="defaultSupplierId"><option value="">No default Supplier</option></select></label><label>Minimum stock<input name="minimumStock" type="number" min="0" step="any" value="0" /></label><label>Barcode text<input name="barcode" /></label><label>Vehicle compatibility note<input name="compatibility" /></label><label id="opening-wrap">Opening balance<input name="opening" type="number" min="0" step="any" value="0" /></label><button type="submit">Save part</button></form></section>
  <section class="workshop-card parts-panel" aria-labelledby="movement-title"><h2 id="movement-title">Record a stock movement</h2><form id="movement-form" class="parts-form"><label>Movement<select name="type"><option value="STOCK_IN">Stock in</option><option value="ISSUE_TO_JOB">Issue to job</option><option value="RETURN_FROM_JOB">Return from job</option><option value="ADJUSTMENT_IN">Adjustment in</option><option value="ADJUSTMENT_OUT">Adjustment out</option></select></label><label>Part<select name="partId" required></select></label><label>Quantity<input name="quantity" type="number" min="0.000001" step="any" required /></label><label>Workshop job<select name="jobId"><option value="">Select workshop job</option></select></label><label>Unit cost (optional)<input name="unitCost" type="number" min="0" step="any" /></label><label>Supplier / reference<input name="supplier" /></label><label>Reference<input name="reference" /></label><label class="parts-span">Note <span>(required for adjustments)</span><input name="note" /></label><button type="submit">Record movement</button></form></section>
  <section class="workshop-card parts-panel" id="job-parts" hidden aria-live="polite"></section>
  <p id="parts-feedback" class="workshop-status" role="status" aria-live="polite" hidden></p>
</WorkshopLayout>

---
import WorkshopLayout from '../../../../components/workshop/WorkshopLayout.astro';
const title = 'QC & Handover | WorkshopGirl Workshop Operations';
const description = 'Verify completed repair work, record road-test and returned items, and complete a local vehicle handover.';
const canonical = 'https://workshopgirl.com/tools/workshop/qc-handover/';
---
<WorkshopLayout title={title} description={description} canonical={canonical} step="qc" heading="QC & handover." intro="Verify the work order and inspection on the same job. A job cannot be marked complete while required checks remain unresolved.">
  <section class="workshop-card"><h2>Final inspection and handover</h2><div id="qc-context"></div><form id="qc-form" class="workshop-form" novalidate>
    <section class="form-section"><h2>QC status</h2><div class="form-grid three-col"><label><span>QC number</span><input name="number" required /></label><label><span>Date</span><input name="date" type="date" /></label><label><span>Final status</span><select name="finalStatus"><option>In progress</option><option>Rework required</option><option>Ready for handover</option></select></label><label><span>Inspector</span><input name="inspector" /></label><label><span>Mechanic</span><input name="mechanic" /></label></div></section>
    <section class="form-section"><h2>Verification checklist</h2><div id="qc-checklist"></div><div class="workshop-row-list" id="qc-extra-rows"></div><button class="button-secondary" type="button" data-add-row="qc-check">Add verification check</button></section>
    <section class="form-section"><h2>Unresolved issues</h2><div class="workshop-row-list" id="qc-issues"></div><button class="button-secondary" type="button" data-add-row="qc-issue">Add unresolved issue</button></section>
    <section class="form-section"><h2>Road test</h2><div class="form-grid three-col"><label><span>Road test</span><select name="roadTest"><option>Not required</option><option>Completed</option><option>Not completed</option></select></label><label><span>Road tester</span><input name="roadTester" /></label><label><span>Odometer before</span><input name="odometerBefore" type="number" min="0" /></label><label><span>Odometer after</span><input name="odometerAfter" type="number" min="0" /></label><label class="form-span-all"><span>Road-test notes</span><textarea name="roadTestNotes"></textarea></label></div></section>
    <section class="form-section"><h2>Returned items and readiness</h2><div class="form-grid"><label><span>Items returned to customer</span><textarea name="returnedItems" placeholder="One item per line"></textarea></label><label><span>Readiness notes</span><textarea name="readinessNotes"></textarea></label><label><span>Recommendations</span><textarea name="recommendations"></textarea></label><label><span>Customer notes</span><textarea name="customerNotes"></textarea></label></div></section>
    <section class="form-section"><h2>Handover</h2><div class="form-grid three-col"><label><span>Recipient</span><input name="handoverRecipient" /></label><label><span>Staff member</span><input name="handoverStaff" /></label><label><span>Date</span><input name="handoverDate" type="date" /></label><label><span>Time</span><input name="handoverTime" type="time" /></label></div></section>
    <p id="qc-warning" class="workshop-status" role="status" hidden></p><p class="field-error" id="qc-error" role="alert" hidden></p><div class="button-row"><button type="submit">Save QC &amp; Handover</button><button class="button-secondary" type="button" id="complete-job">Complete job</button></div>
  </form><div class="workflow-next" id="job-completed" hidden><h2>Phase 1 job complete</h2><p>QC and handover are saved locally with this workshop job.</p><a href="/tools/workshop/vehicle-intake/">Start another intake →</a></div></section>
</WorkshopLayout>

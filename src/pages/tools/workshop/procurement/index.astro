---
import WorkshopLayout from '../../../../components/workshop/WorkshopLayout.astro';
const path='/tools/workshop/procurement/';
const title='Workshop Procurement | Purchase Needs, Orders & Receiving | WorkshopGirl';
const description='Create local purchase needs, issue supplier Purchase Orders, receive stock partially, and trace accepted goods into the workshop inventory ledger.';
---
<WorkshopLayout title={title} description={description} canonical={`https://workshopgirl.com${path}`} step="procurement" heading="Workshop Procurement." intro="Confirm purchase needs, prepare supplier orders, and record received goods into the Parts Inventory ledger. Procurement stays in this browser.">
  <div id="procurement-root" class="procurement-root"></div>
  <p id="procurement-feedback" class="workshop-status" role="status" aria-live="polite" hidden></p>
</WorkshopLayout>
<style is:global>
  .workshop-page[data-workshop-step="procurement"] .procurement-root{display:grid;gap:16px;min-width:0}.workshop-page[data-workshop-step="procurement"] .procurement-section{min-width:0}.workshop-page[data-workshop-step="procurement"] .procurement-section>p{max-width:75ch}.workshop-page[data-workshop-step="procurement"] .proc-form{align-items:end;display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));margin:12px 0}.workshop-page[data-workshop-step="procurement"] .proc-form label{display:grid;gap:5px;min-width:0}.workshop-page[data-workshop-step="procurement"] .proc-form label input,.workshop-page[data-workshop-step="procurement"] .proc-form label select,.workshop-page[data-workshop-step="procurement"] .proc-form label textarea{background:#fff;border:1px solid #bdb5ac;border-radius:3px;color:#171717;font:inherit;font-size:16px;min-height:44px;min-width:0;padding:9px;width:100%}.workshop-page[data-workshop-step="procurement"] .proc-form label select{max-width:100%}.workshop-page[data-workshop-step="procurement"] .proc-form textarea{min-height:76px}.workshop-page[data-workshop-step="procurement"] .proc-form button,.workshop-page[data-workshop-step="procurement"] .proc-card button{min-height:44px}.workshop-page[data-workshop-step="procurement"] .proc-list,.workshop-page[data-workshop-step="procurement"] .proc-lines{display:grid;gap:10px;min-width:0}.workshop-page[data-workshop-step="procurement"] .proc-card{background:#fffaf4;border:1px solid #ded8d0;min-width:0;overflow-wrap:anywhere;padding:14px}.workshop-page[data-workshop-step="procurement"] .proc-card h3{align-items:center;display:flex;flex-wrap:wrap;gap:8px;margin:0 0 8px}.workshop-page[data-workshop-step="procurement"] .proc-card h4{margin:.25rem 0}.workshop-page[data-workshop-step="procurement"] .proc-card p{margin:.5rem 0}.workshop-page[data-workshop-step="procurement"] .proc-status{background:#eee7df;border-radius:20px;display:inline-block;font-size:.8rem;font-weight:700;padding:4px 9px}.workshop-page[data-workshop-step="procurement"] .proc-warning{background:#fff1ed;border:1px solid #a82d25;color:#6e1c18;padding:10px}.workshop-page[data-workshop-step="procurement"] .proc-select,.workshop-page[data-workshop-step="procurement"] .proc-form fieldset,.workshop-page[data-workshop-step="procurement"] .proc-line{border:1px solid #ded8d0;display:grid;gap:9px;min-width:0;padding:12px}.workshop-page[data-workshop-step="procurement"] .proc-select>label,.workshop-page[data-workshop-step="procurement"] .proc-form fieldset>label{align-items:start;display:flex;gap:8px}.workshop-page[data-workshop-step="procurement"] .proc-select input,.workshop-page[data-workshop-step="procurement"] .proc-form fieldset input[type=checkbox]{flex:0 0 20px;height:20px;margin:1px 0;width:20px}.workshop-page[data-workshop-step="procurement"] .proc-po{display:grid;gap:12px}.workshop-page[data-workshop-step="procurement"] .proc-po-form{border-top:1px solid #ded8d0;padding-top:12px}.workshop-page[data-workshop-step="procurement"] .proc-line{background:#fff}.workshop-page[data-workshop-step="procurement"] .proc-line>label{max-width:100%;overflow-wrap:anywhere}.workshop-page[data-workshop-step="procurement"] .proc-actions{display:flex;flex-wrap:wrap;gap:8px}.workshop-page[data-workshop-step="procurement"] .proc-actions>*{flex:0 1 auto}.workshop-page[data-workshop-step="procurement"] .proc-lines ul{margin:.3rem 0}.workshop-page[data-workshop-step="procurement"] .procurement-root button:focus-visible,.workshop-page[data-workshop-step="procurement"] .procurement-root input:focus-visible,.workshop-page[data-workshop-step="procurement"] .procurement-root select:focus-visible,.workshop-page[data-workshop-step="procurement"] .procurement-root textarea:focus-visible{outline:3px solid #1769aa;outline-offset:2px}.workshop-page[data-workshop-step="procurement"] #procurement-print{display:none}
  @media(max-width:520px){.workshop-page[data-workshop-step="procurement"] .proc-form{grid-template-columns:minmax(0,1fr)}.workshop-page[data-workshop-step="procurement"] .proc-actions>*{flex:1 1 100%;width:100%}}
  @media print{body.print-procurement>header,body.print-procurement>footer,body.print-procurement .site-header,body.print-procurement .site-footer,body.print-procurement .workshop-page>*:not(#procurement-root),body.print-procurement #procurement-root>*:not(#procurement-print){display:none!important}body.print-procurement #procurement-print{display:block!important}body.print-procurement #procurement-print table{border-collapse:collapse;width:100%}body.print-procurement #procurement-print th,body.print-procurement #procurement-print td{border:1px solid #777;padding:8px;text-align:left}body.print-procurement #procurement-print h1{font-size:1.6rem}}
</style>

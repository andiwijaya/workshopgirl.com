---
import { siteNavigation, siteSection } from '../data/navigation.ts';
const current = siteSection(Astro.url.pathname);
---
<footer class="site-footer">
  <div class="footer-brand"><a href="/">Workshop<span>Girl</span><sup>™</sup></a><p>Real machines. Real skills. Better days.</p></div>
  <nav aria-label="Footer navigation">{siteNavigation.map(link => <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>)}</nav>
</footer>

<style>
  .site-footer { align-items:flex-end; border-top:1px solid var(--line,#ded8d0); display:flex; gap:30px; justify-content:space-between; margin:0 auto; max-width:1280px; padding:30px 5vw 36px; position:relative; z-index:1; }
  .footer-brand a { color:var(--ink,#171717); font-family:'Space Grotesk',sans-serif; font-size:1.1rem; font-weight:700; letter-spacing:-.04em; text-decoration:none; }
  .footer-brand a span { color:var(--pink,#e53b7d); } .footer-brand sup { font-size:.55em; } .footer-brand p { color:var(--muted,#655f59); font-size:.82rem; margin:8px 0 0; }
  .site-footer nav { display:flex; flex-wrap:wrap; gap:18px; } .site-footer nav a { color:var(--muted,#655f59); font-size:.84rem; text-decoration:none; } .site-footer nav a:hover,.site-footer nav a:focus-visible,.site-footer nav a[aria-current='page'] { color:var(--pink,#e53b7d); }
  .site-footer :focus-visible { outline:3px solid var(--pink,#e53b7d); outline-offset:4px; }
  @media (max-width:700px) { .site-footer { align-items:flex-start; flex-direction:column; padding:28px 7vw 34px; } .site-footer nav { gap:12px 18px; } }
</style>

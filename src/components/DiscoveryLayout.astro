---
import SeoHead from './SeoHead.astro';
import SiteHeader from './SiteHeader.astro';
import LocalJobContext from './LocalJobContext.astro';
import SiteFooter from './SiteFooter.astro';
import '../styles/discovery.css';
interface Props { title: string; description: string; canonical: string; image?: string }
const { title, description, canonical, image } = Astro.props;
---
<!doctype html><html lang="en"><head><LocalJobContext />
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <SeoHead title={title} description={description} canonical={canonical} image={image} />
</head><body><a class="skip-link" href="#main">Skip to content</a><SiteHeader /><main id="main" class="discovery" tabindex="-1"><slot /></main><SiteFooter /></body></html>

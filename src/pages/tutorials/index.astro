---
import { tutorials } from '../../data/tutorials';
import SiteHeader from '../../components/SiteHeader.astro';

const title = 'Tutorials | WorkshopGirl';
const description = 'Practical Workshop Girl tutorials for learning useful workshop and vehicle maintenance skills.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://workshopgirl.com/tutorials/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://workshopgirl.com/tutorials/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
      :root { --ink:#171717; --muted:#655f59; --paper:#f7f4ef; --pink:#e53b7d; --orange:#e58445; --line:#ded8d0; }
      * { box-sizing:border-box; }
      html { background:var(--paper); color:var(--ink); font-family:'DM Sans',sans-serif; }
      body { margin:0; min-width:320px; }
      a { color:inherit; }
      .shell { min-height:100vh; overflow:hidden; position:relative; }
      .shell::before { content:''; position:absolute; inset:0; pointer-events:none; opacity:.22; background-image:radial-gradient(#b8afa4 .7px,transparent .7px); background-size:18px 18px; mask-image:linear-gradient(to bottom,black,transparent 75%); }
      header { align-items:center; display:flex; justify-content:space-between; margin:0 auto; max-width:1180px; padding:30px 5vw; position:relative; z-index:1; }
      .brand { font-family:'Space Grotesk',sans-serif; font-size:1.2rem; font-weight:700; letter-spacing:-.04em; text-decoration:none; }
      .brand span, .eyebrow { color:var(--pink); }
      nav { display:flex; gap:24px; }
      nav a { color:var(--muted); font-size:.9rem; text-decoration:none; }
      nav a:hover, nav a:focus-visible { color:var(--pink); }
      main { margin:0 auto; max-width:1180px; padding:9vh 5vw 12vh; position:relative; z-index:1; }
      .intro { max-width:700px; }
      .eyebrow { font-size:.78rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
      h1 { font-family:'Space Grotesk',sans-serif; font-size:clamp(3.5rem,7vw,6.5rem); letter-spacing:-.075em; line-height:.92; margin:22px 0; }
      .lead { color:var(--muted); font-size:1.2rem; line-height:1.7; max-width:620px; }
      .rule { border:0; border-top:1px solid var(--line); margin:65px 0 28px; }
      .section-label { color:var(--muted); font-size:.8rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
      .card { background:#fffaf4; border:1px solid var(--line); display:grid; grid-template-columns:minmax(280px, .9fr) 1.1fr; margin-top:18px; }
      .card img { display:block; height:100%; min-height:300px; object-fit:cover; width:100%; }
      .card-copy { align-self:center; padding:clamp(26px,5vw,64px); }
      .category { color:var(--pink); font-size:.78rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
      h2 { font-family:'Space Grotesk',sans-serif; font-size:clamp(2rem,4vw,3.5rem); letter-spacing:-.06em; line-height:1; margin:16px 0; }
      .card p { color:var(--muted); line-height:1.7; }
      .date { color:var(--muted); font-size:.85rem; }
      .button { background:var(--ink); color:#fff; display:inline-block; font-weight:700; margin-top:18px; padding:13px 19px; text-decoration:none; }
      .button:hover, .button:focus-visible { background:var(--pink); }
      :focus-visible { outline:3px solid var(--pink); outline-offset:4px; }
      @media (max-width:700px) { header { padding:22px 7vw; } nav { gap:14px; } nav a:nth-child(n+3) { display:none; } main { padding:7vh 7vw 10vh; } .card { display:block; } .card img { height:auto; min-height:0; } }
    </style>
  </head>
  <body>
    <div class="shell">
      <SiteHeader current="tutorials" />
      <main>
        <section class="intro">
          <div class="eyebrow">Learn by doing</div>
          <h1>Tutorials.</h1>
          <p class="lead">Practical, step-by-step guides for learning useful workshop skills, understanding your machines, and making the next repair feel a little less intimidating.</p>
        </section>
        <hr class="rule" />
        <div class="section-label">Latest tutorial</div>
        {tutorials.map((tutorial) => (
          <article class="card">
            <img src={tutorial.image} alt={tutorial.imageAlt} width="1672" height="941" loading={tutorial.slug === tutorials[0].slug ? 'eager' : 'lazy'} />
            <div class="card-copy">
              <div class="category">{tutorial.category}</div>
              <h2>{tutorial.title}</h2>
              <p>{tutorial.description}</p>
              <div class="date">{tutorial.published}</div>
              <a class="button" href={tutorial.slug}>Read the tutorial</a>
            </div>
          </article>
        ))}
      </main>
    </div>
  </body>
</html>

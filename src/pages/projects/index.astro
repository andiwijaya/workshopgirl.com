---
import { projects } from '../../data/projects';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';

const title = 'Projects | WorkshopGirl';
const description = 'Follow WorkshopGirl projects from first inspection to finished result — longer builds, repairs, experiments and lessons learned with real machines and practical skills.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><link rel="canonical" href="https://workshopgirl.com/projects/" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content="https://workshopgirl.com/projects/" /><meta property="og:image" content="https://workshopgirl.com/images/projects/old-motorcycle/workshopgirl-old-motorcycle-project-hero.webp?v=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{title}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
      :root { --ink:#171717; --muted:#655f59; --paper:#f7f4ef; --pink:#e53b7d; --line:#ded8d0; --soft:#fffaf4; } * { box-sizing:border-box; } html { background:var(--paper); color:var(--ink); font-family:'DM Sans',sans-serif; } body { margin:0; min-width:320px; } a { color:inherit; }
      .shell { min-height:100vh; overflow:hidden; position:relative; } .shell::before { content:''; position:absolute; inset:0; pointer-events:none; opacity:.22; background-image:radial-gradient(#b8afa4 .7px,transparent .7px); background-size:18px 18px; mask-image:linear-gradient(to bottom,black,transparent 75%); }
      main { margin:0 auto; max-width:1180px; padding:9vh 5vw 12vh; position:relative; z-index:1; } .intro { max-width:750px; } .eyebrow,.category { color:var(--pink); font-size:.78rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; } h1,h2 { font-family:'Space Grotesk',sans-serif; letter-spacing:-.075em; } h1 { font-size:clamp(3.1rem,6vw,5.8rem); line-height:.93; margin:22px 0; } .lead { color:var(--muted); font-size:1.2rem; line-height:1.7; max-width:650px; } .rule { border:0; border-top:1px solid var(--line); margin:65px 0 28px; } .section-label { color:var(--muted); font-size:.8rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
      .card { background:var(--soft); border:1px solid var(--line); display:grid; grid-template-columns:minmax(300px,1.15fr) 1fr; margin-top:18px; } .card img { display:block; height:100%; min-height:360px; object-fit:cover; width:100%; } .card-copy { align-self:center; padding:clamp(28px,5vw,68px); } h2 { font-size:clamp(2.2rem,4.2vw,4rem); line-height:.98; margin:16px 0; } .status { color:var(--muted); font-size:.85rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; } .card p { color:var(--muted); line-height:1.7; } .button { background:var(--ink); color:#fff; display:inline-block; font-weight:700; margin-top:18px; padding:13px 19px; text-decoration:none; } .button:hover,.button:focus-visible { background:var(--pink); } :focus-visible { outline:3px solid var(--pink); outline-offset:4px; }
      @media (max-width:700px) { main { padding:7vh 7vw 10vh; } h1 { font-size:clamp(3rem,13vw,5.3rem); } .card { display:block; } .card img { height:auto; min-height:0; } .card-copy { padding:28px 22px 30px; } h2 { font-size:2.25rem; } }
    </style>
  </head>
  <body><div class="shell"><SiteHeader current="projects" /><main>
    <section class="intro"><div class="eyebrow">Projects</div><h1>Machines are better when you get your hands dirty.</h1><p class="lead">Projects are where individual skills come together. Follow Workshop Girl through longer builds, repairs and experiments — from the first inspection to the moment the machine works again.</p></section>
    <hr class="rule" /><div class="section-label">Latest project</div>
    {projects.map((project) => <article class="card"><img src={project.image} alt={project.imageAlt} width="1672" height="941" loading="eager" /><div class="card-copy"><div class="category">{project.category}</div><h2>{project.title}</h2><p>{project.excerpt}</p><div class="status">Status · {project.status}</div><a class="button" href={project.slug}>View project</a></div></article>)}
  </main><SiteFooter /></div></body>
</html>

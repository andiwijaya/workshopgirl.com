---
import { workshopPages } from '../../lib/workshop/navigation.ts';
import { workshopFlow } from '../../data/journeys.ts';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import ToolShare from '../ToolShare.astro';
import '../../styles/workshop-operations.css';
interface Props { title: string; description: string; canonical: string; step: string; heading: string; intro: string }
const { title, description, canonical, step, heading, intro } = Astro.props;
const steps = workshopPages;
const printKind = steps.find(page => page.id === step)?.print;
---
<!doctype html><html lang="en"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head><body>
  <a class="skip-link" href="#main" tabindex="0">Skip to workshop tool</a><SiteHeader current="workshop" />
  <main id="main" class="workshop-page" tabindex="-1" data-workshop-step={step}>
    <div class="workshop-hero"><a class="eyebrow" href="/workshop/">WorkshopGirl / Workshop</a><p class="operation-label">Workshop Operations</p><h1>{heading}</h1><p>{intro}</p><ToolShare title={title} description={description} canonical={canonical} /></div>
    <div class="workshop-steps">
      <p class="workflow-label">Service workflow</p>
      <nav class="workshop-step-group" aria-label="Workshop job pages">
        {workshopFlow.stages.map((stage, index) => { const page = steps.find(page => page.id === stage.page)!; return <a href={page.href} data-step-link={page.id} aria-current={step === page.id ? 'page' : undefined} class:list={{ 'is-current': step === page.id }} title={stage.description}><span aria-hidden="true">{index + 1}</span>{page.label}</a>; })}
      </nav>
      <p class="workflow-label">Supporting operations — use when needed</p>
      <nav class="workshop-step-group" aria-label="Supporting workshop operations">
        {workshopFlow.support.map(id => { const page = steps.find(page => page.id === id)!; return <a href={page.href} data-step-link={page.id} aria-current={step === page.id ? 'page' : undefined} class:list={{ 'is-current': step === page.id }}>{page.label}</a>; })}
      </nav>
    </div>
    <p class="workshop-status" id="workshop-status" role="status" aria-live="polite" hidden></p>
    <p class="local-storage-note">Saved records stay in this browser profile on this device. Clearing browser data removes them; there is no server backup or cross-device sync.</p>
    <section id="workshop-empty" class="workshop-job-context" hidden aria-label="Getting started"></section>
    <div class="workshop-job-context" id="workshop-job-context" hidden></div>
    <div class="workshop-job-picker" id="workshop-job-picker" hidden></div>
    <slot />
    <section class="print-sheet" id="print-sheet" hidden aria-label="Printable workshop document"><div class="print-brand">Workshop<span>Girl</span> · Workshop Operations</div><h2 id="print-title"></h2><div id="print-content"></div></section>
    <div class="workshop-page-actions"><a class="button-link button-secondary" href="/workshop/">Workshop home</a>{printKind !== 'record' && <button class="button-secondary" type="button" data-print>{printKind === 'queue' ? 'Print queue summary' : printKind === 'parts' ? 'Print inventory summary' : 'Print / Save as PDF'}</button>}</div>
  </main>
  <SiteFooter />
  <script>import { mountWorkshopPage } from './operations.ts'; mountWorkshopPage(document.querySelector<HTMLElement>('#main')!);</script>
</body></html>
